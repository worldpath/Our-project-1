# Binance API Credentials (REQUIRED)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Exchange Configuration
EXCHANGE=binance.us
API_PORT=8889
API_HOST=0.0.0.0

# Live Trading Configuration (CRITICAL)
LIVE_TRADING=true
AGREE_TO_RISK=YES

# Risk Management
RISK_PER_TRADE=15.0
MAX_DAILY_LOSS=12.0
MAX_PORTFOLIO_HEAT=80.0
MAX_CONCURRENT_POSITIONS=12

# API Security
ENABLE_API=true

# Paths
TRADE_LOG_FILE=/app/data/trade_history.csv
RISK_STATE_PATH=/app/data/risk_state.json
