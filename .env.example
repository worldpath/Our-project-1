# ===============================
# Binance.US API
# ===============================
BINANCE_US_API_KEY=your_api_key_here
BINANCE_US_API_SECRET=your_api_secret_here
BINANCE_US_BASE_URL=https://api.binance.us

# Preferred adapter: connector (Binance US) or ccxt
EXCHANGE_ADAPTER=connector

# ===============================
# Email reporting
# ===============================
ENABLE_EMAIL_REPORTS=0
REPORT_TO_EMAIL=bschneid7@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address
SMTP_PASS=your_app_password   # Gmail App Password, not your login
SMTP_FROM=your_gmail_address

# ===============================
# Historical data provider
# ===============================
HIST_PROVIDER=cryptocompare
CRYPTOCOMPARE_API_KEY=your_api_key
# KAIKO_API_KEY=your_api_key   # if you later use Kaiko

# ===============================
# Live trading options
# ===============================
# Shadow mode: run full live loop but do not place orders
SHADOW_LIVE=0
# Override min notional sizing (USD) if needed
MIN_NOTIONAL_USD=20
