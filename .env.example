
# Binance.US API Credentials
# Get your API keys from: https://www.binance.us/en/usercenter/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Trading Mode
# Options: 'live' or 'paper'
TRADING_MODE=paper

# Configuration File
# Options: config/ultra_aggressive.yaml, config/custom.yaml, etc.
CONFIG_FILE=config/ultra_aggressive.yaml

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8889
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your_secure_random_api_key_here

# Risk Management (can override config file)
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.15
MAX_POSITIONS=3

# Optional: Email Notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# NOTIFICATION_EMAIL=your_email@gmail.com
