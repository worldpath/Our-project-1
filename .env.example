# Core trading configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_here
BINANCEUS_API_KEY=your_binanceus_api_key_here
BINANCEUS_API_SECRET=your_binanceus_secret_here
PAIRS=BTC/USDT,ETH/USDT

# Environment and logging
LIVE_TRADING=false
AGREE_TO_RISK=NO
ENVIRONMENT=production
LOG_LEVEL=INFO
CONFIG_PATH=config/aggressive_production.yaml

# Dashboard configuration
# Control UI proxy injects X-API-Key; set it in server env only
CONTROL_UI_API_KEY=
CONTROL_UI_ALLOWED_ORIGIN=
DASHBOARD_USER=admin
DASHBOARD_PASS=secure_password_here
DASHBOARD_JWT_SECRET=your_jwt_secret_here_change_me_in_production
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_TOKEN_TTL_MIN=720

# Tax tracking configuration

# Optional: Coinbase Spot (add keys later)
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=
COINBASE_USE_SANDBOX=false

# Margin trading (pilot: off by default)
MARGIN_ENABLED=false
AGREE_TO_MARGIN=NO

# Staking control
STAKING_ENABLED=true
TAX_COST_METHOD=FIFO
TAX_DB_PATH=tax_data.db
ENABLE_TAX_TRACKING=true

# Notification settings
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=alerts@yourcompany.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Health monitoring
HEALTH_MONITOR_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_RETENTION_DAYS=30
SEND_HEALTH_ALERTS=true

# Backup configuration
BACKUP_ENABLED=true
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# Risk management
# Immutable hard guardrails (enforced by code)
MAX_RISK_PER_TRADE_HARD=0.25
MAX_DAILY_LOSS_HARD=0.50

# Soft defaults below
MAX_POSITION_SIZE=15.0
PORTFOLIO_RISK=30.0
MAX_DAILY_LOSS=12.0
MAX_DRAWDOWN=35.0
RISK_PER_TRADE=5.0
