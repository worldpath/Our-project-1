# ULTRA-AGGRESSIVE Trading Bot Configuration - MAXIMUM RISK/REWARD
# ================================================================
# ⚠️  WARNING: These settings use maximum risk for maximum gains!
# Copy this file to .env and update with your actual credentials

# Binance API Credentials (REQUIRED)
# Get these from: https://binance.us/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ULTRA-AGGRESSIVE TRADING SETTINGS - MAXIMUM RISK/REWARD
# ========================================================
# 🚨 These are EXTREME settings designed for maximum gains
PORTFOLIO_RISK=95.0                    # 95% of portfolio at risk
MAX_POSITION_SIZE=75.0                 # 75% max single position 
RISK_PER_TRADE=25.0                    # 25% risk per individual trade
MAX_CONCURRENT_POSITIONS=15            # Up to 15 simultaneous positions

# Portfolio and Risk Management
REAL_PORTFOLIO_VALUE=10000             # Your actual portfolio value
INITIAL_CAPITAL=10000                  # Starting capital amount
MAX_DAILY_LOSS=25.0                    # 25% daily loss limit
MAX_DRAWDOWN=60.0                      # 60% maximum drawdown allowed
EMERGENCY_STOP=70.0                    # 70% emergency stop level

# Trading Configuration
TRADING_MODE=ultra_aggressive          # Ultra-aggressive mode
LIVE_TRADING=true                      # Enable live trading
AUTOMATED_TRADING=true                 # Full automation
OPERATION_24_7=true                    # 24/7 trading

# Performance Settings
SIGNAL_THRESHOLD=0.4                   # Lower = more trades (aggressive)
CONFIDENCE_THRESHOLD=0.4               # Lower confidence required
RISK_REWARD_THRESHOLD=1.2              # Lower risk/reward ratio accepted
CONSECUTIVE_LOSS_LIMIT=8               # Allow more consecutive losses

# Email Notifications (Optional)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Telegram Notifications (Optional)  
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Database (Optional - uses SQLite by default)
DATABASE_URL=sqlite:///ultra_aggressive_bot.db

# Monitoring (Optional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin123

# Alert Configuration
ALERT_EMAIL=your_alerts@gmail.com

# Advanced Features (Optional)
OPENAI_API_KEY=your_openai_key_for_ml_features

# Deployment Settings
FORCE_TESTNET=false                    # Set to true for paper trading
SKIP_CONFIRMATION=true                 # Skip manual confirmations
CONFIG_PATH=config/ultra_aggressive.yaml

# Backup Configuration (Optional)
BACKUP_S3_BUCKET=your_backup_bucket
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# ⚠️  ULTRA-AGGRESSIVE MODE WARNINGS:
# ====================================
# - This configuration uses 95% portfolio risk
# - Single positions can be up to 75% of portfolio
# - Up to 15 concurrent positions allowed
# - 25% risk per trade with lower quality requirements
# - Faster 5-minute trading cycles
# - More lenient risk management thresholds
# 
# 🎯 POTENTIAL OUTCOMES:
# - MAXIMUM GAINS: Potential for 1000x+ returns
# - MAXIMUM RISK: Potential for 70%+ losses
# - HIGH VOLATILITY: Extreme profit/loss swings
# 
# 💡 RECOMMENDED ONLY FOR:
# - Experienced traders with high risk tolerance
# - Portfolio you can afford to lose completely
# - Understanding of crypto market volatility