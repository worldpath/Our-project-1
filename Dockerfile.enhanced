# Enhanced Trading Bot Dockerfile
# ===============================
# Production-ready container for the Ultra-Aggressive Enhanced Trading Bot

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY enhanced_requirements.txt requirements.txt ./
RUN pip install --no-cache-dir -r enhanced_requirements.txt

# Copy source code
COPY . .

# Create necessary directories
RUN mkdir -p logs config tax_reports data persistent_data

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash --uid 1001 trader
RUN chown -R trader:trader /app
USER trader

# Set Python path
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8080/health')" || exit 1

# Expose ports
EXPOSE 8080 9090

# Default command
CMD ["python", "start_enhanced_bot.py", "live"]